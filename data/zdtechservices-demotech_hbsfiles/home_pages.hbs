// Smooth scrolling for anchor links
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
});
</script>

<style>
/* Dropdown overlay animation: fade + slight translate */
#get-demo-studio-menu {
  opacity: 0;
  transform: translateY(-6px) scale(0.995);
  transition: opacity 180ms ease, transform 180ms ease;
  will-change: opacity, transform;
}
#get-demo-studio-menu.show {
  opacity: 1;
  transform: translateY(0) scale(1);
}
</style>

<script>
// Demo Studio subdomain picker (portal overlay to prevent layout shifts)
document.addEventListener('DOMContentLoaded', function() {
  const btn = document.getElementById('get-demo-studio-btn');
  const menu = document.getElementById('get-demo-studio-menu');
  const input = document.getElementById('demo-subdomain');
  const submit = document.getElementById('demo-subdomain-submit');

  if (!btn || !menu || !input || !submit) return;

  // Move the menu to document.body so it becomes a top-level overlay (portal)
  const originalParent = menu.parentNode;
  menu.style.position = 'absolute';
  menu.style.display = 'none';
  document.body.appendChild(menu);

  // Helper to measure and position the menu aligned to the button (right-aligned)
  function positionMenu() {
    const prevDisplay = menu.style.display;
    const prevVisibility = menu.style.visibility;
    if (prevDisplay === 'none') {
      menu.style.visibility = 'hidden';
      menu.style.display = 'block';
    }

    const btnRect = btn.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();

    let top = btnRect.bottom + window.scrollY + 8; // 8px gap
    let left = btnRect.right + window.scrollX - menuRect.width; // right-align to button

    const minLeft = 8 + window.scrollX;
    const maxLeft = document.documentElement.clientWidth + window.scrollX - menuRect.width - 8;
    if (left < minLeft) left = minLeft;
    if (left > maxLeft) left = maxLeft;

    menu.style.top = top + 'px';
    menu.style.left = left + 'px';

    menu.style.display = prevDisplay;
    menu.style.visibility = prevVisibility;
  }

  // Animation helpers: use 'show' class to animate in/out
  function animateOpen() {
    positionMenu();
    menu.classList.add('show');
    menu.style.display = 'block';
    btn.setAttribute('aria-expanded', 'true');
    setTimeout(() => { input.focus(); }, 0);
  }

  function animateClose() {
    // remove 'show' to let CSS animate out, then hide after transition
    menu.classList.remove('show');
    btn.setAttribute('aria-expanded', 'false');
    const onEnd = function() {
      menu.style.display = 'none';
      menu.removeEventListener('transitionend', onEnd);
    };
    menu.addEventListener('transitionend', onEnd);
  }

  // Only attach toggle behavior if the control is a BUTTON. If it's an anchor (temporary), we don't intercept clicks.
  if (btn.tagName === 'BUTTON') {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isHidden = window.getComputedStyle(menu).display === 'none' || menu.style.display === 'none';
      if (isHidden) {
        document.querySelectorAll('#get-demo-studio-menu').forEach(m => { if (m !== menu) { m.classList.remove('show'); m.style.display = 'none'; } });
        animateOpen();
      } else {
        animateClose();
      }
    });
  }

  function onGlobalMove() {
    if (window.getComputedStyle(menu).display !== 'none') positionMenu();
  }
  window.addEventListener('resize', onGlobalMove);
  window.addEventListener('scroll', onGlobalMove, true);

  document.addEventListener('click', function() {
    if (window.getComputedStyle(menu).display !== 'none') animateClose();
  });

  menu.addEventListener('click', function(e) {
    e.stopPropagation();
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      submit.click();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (window.getComputedStyle(menu).display !== 'none') animateClose();
    }
  });

  submit.addEventListener('click', function(e) {
    e.preventDefault();
    const val = (input.value || '').trim();
    if (!val) {
      input.focus();
      return;
    }
    const cleaned = val.replace(/^https?:\/\//i, '').replace(/\.zendesk\.com.*$/i, '').replace(/\/.*/g,'');
    const url = `https://${encodeURIComponent(cleaned)}.zendesk.com/api/support/apps/1166513/approve`;
    window.open(url, '_blank');
    animateClose();
  });
});
</script>