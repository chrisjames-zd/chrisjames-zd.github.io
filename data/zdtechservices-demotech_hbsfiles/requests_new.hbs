<style>
  /* Page enter animation */
  @keyframes pageEnter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .page-enter-animate { animation: pageEnter 360ms cubic-bezier(.22,.9,.3,1) both; }

  /* Backdrop visible state */
  #overlay-backdrop.show { pointer-events: auto; opacity: 1; }

  /* Role button styling (replace emojis with MDI icons via JS and class names) */
  .role-button { display:inline-flex; align-items:center; gap:.5rem; padding:.6rem .9rem; border-radius:.5rem; font-weight:600; text-decoration:none; }
  .role-button .mdi { font-size:1.05rem; line-height:1; }
  .role-button.solution-developer { background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 88%, black 12%)); color: #fff; }
  .role-button.demo-architect { background: linear-gradient(180deg, var(--success), color-mix(in srgb, var(--success) 88%, black 12%)); color: #fff; }

  /* Small accessibility focus outline */
  .role-button:focus { outline: 2px solid rgba(27,38,59,0.12); outline-offset: 2px; }

  /* Decorative ambient blobs (inspired by home_pages.hbs) */
  .blob { position: absolute; pointer-events: none; filter: blur(40px) saturate(140%); opacity: 0.8; transform: translate3d(0,0,0); z-index: 0; }
  /* Larger, more vibrant blobs balanced vertically in the section */
  .blob-1 { width: 560px; height: 320px; left: -120px; top: 4%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 86%, white 14%), transparent 60%); }
  .blob-2 { width: 640px; height: 420px; right: -160px; top: 28%; background: radial-gradient(closest-side, color-mix(in srgb, var(--success) 86%, white 14%), transparent 60%); }
  /* Changed the previous 'primary' grey-ish blob to a vibrant red */
  .blob-3 { width: 480px; height: 300px; left: 8%; top: 56%; background: radial-gradient(closest-side, color-mix(in srgb, #e03b3b 88%, white 12%), transparent 60%); }
  /* New blue ambient blob for subtle effect (larger, slower) */
  .blob-4 { width: 420px; height: 260px; right: 6%; top: 72%; background: radial-gradient(closest-side, color-mix(in srgb, #2b6df6 92%, white 8%), transparent 60%); opacity: 0.7; filter: blur(48px) saturate(150%); }

  @keyframes floaty {
    0% { transform: translateY(0) rotate(0deg) scale(1); }
    50% { transform: translateY(-12px) rotate(6deg) scale(1.03); }
    100% { transform: translateY(0) rotate(0deg) scale(1); }
  }
  .animate-floaty { animation: floaty 6s cubic-bezier(.2,.9,.3,1) infinite; }
  /* Make sure main content sits above blobs */
  #main-content { position: relative; z-index: 20; }
  .animate-floaty-slow { animation: floaty 10s cubic-bezier(.2,.9,.3,1) infinite; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Page enter animation
  const mainContent = document.getElementById('main-content');
  if (mainContent) {
    mainContent.classList.add('page-enter-animate');
  }

  // Ensure backdrop exists and is toggled when overlays (like the Demo Studio menu) open.
  let backdrop = document.getElementById('overlay-backdrop');
  if (!backdrop) {
    backdrop = document.createElement('div');
    backdrop.id = 'overlay-backdrop';
    document.body.appendChild(backdrop);
  }

  function showBackdrop() {
    backdrop.style.display = 'block';
    // allow CSS transition
    requestAnimationFrame(() => backdrop.classList.add('show'));
  }
  function hideBackdrop() {
    backdrop.classList.remove('show');
    // after transition hide from flow
    backdrop.addEventListener('transitionend', function onEnd() {
      backdrop.style.display = 'none';
      backdrop.removeEventListener('transitionend', onEnd);
    });
  }

  // If the Demo Studio menu exists, observe its class changes to toggle backdrop
  const demoMenu = document.getElementById('get-demo-studio-menu');
  if (demoMenu) {
    const mo = new MutationObserver(() => {
      if (demoMenu.classList.contains('show')) showBackdrop(); else hideBackdrop();
    });
    mo.observe(demoMenu, { attributes: true, attributeFilter: ['class'] });
  }

  // Replace emojis in role buttons and add MDI icons + theme colors.
  // Map role text -> {iconClass, roleClass}
  const roleMap = [
    { text: 'Solution Developer', icon: 'mdi-laptop-code', cls: 'solution-developer' },
    { text: 'Demo Architect', icon: 'mdi-account-cog-outline', cls: 'demo-architect' }
  ];

  // Find elements that look like role buttons (buttons/links) and apply changes
  document.querySelectorAll('button, a, input[type=button], input[type=submit]').forEach(el => {
    const txt = (el.textContent || el.value || '').trim();
    roleMap.forEach(role => {
      if (new RegExp('\\b' + role.text + '\\b', 'i').test(txt)) {
        // Remove emoji characters from text
        const clean = txt.replace(/[\p{Emoji_Presentation}\p{Emoji}\u2600-\u27BF]/gu, '').trim();
        const label = clean || role.text;
        // Build inner HTML with mdi icon
        if (el.tagName.toLowerCase() === 'input') {
          // replace value for inputs
          el.value = label;
          el.classList.add('role-button', role.cls);
        } else {
          el.innerHTML = '<span class="mdi ' + role.icon + '" aria-hidden="true"></span> ' + label;
          el.classList.add('role-button', role.cls);
        }
      }
    });
  });
});
</script>